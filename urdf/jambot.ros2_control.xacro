<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="jambot_ros2_control" params="name prefix">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>jambot_nano/JamBotNanoHardware</plugin>
        <param name="left_wheel_name">left_wheel_joint</param>
        <param name="right_wheel_name">right_wheel_joint</param>
        <param name="loop_rate">30</param>
        <param name="device">/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0</param>
        <param name="baud_rate">115200</param>
        <param name="timeout_ms">100</param>
        <param name="enc_counts_per_rev">404</param>
        <!-- Order is Kp Kd Ki Ko. MUST match the firmware speed-PID gains.
             Previous values 20/12/0/50 came from another driver's PID scaling
             and are wrong here (Kp 33x high, Kd 12000x high, and Ko=50 scales
             the PID output in applyMotorSpeed so anything nonzero saturates to
             +/-255), which caused a full scale forward/reverse limit cycle on
             every launch. Harmless only while the firmware 'p' handler was a
             no-op; re-enabling live tuning exposed them. -->
        <param name="pid_p">0.6</param>
        <param name="pid_d">0.001</param>
        <!-- Lowered from 1.7, live-tested to reduce integral-windup
             overshoot at the turn-to-straight transition. See speedPID's
             filter fix in jambot.ino for the primary cause of that
             symptom; this is a secondary contributor. -->
        <param name="pid_i">0.85</param>
        <param name="pid_o">1.0</param>
        <!-- Set to "true" to log every read/write cycle's firmware state
             (encoders, PID target, PWM, filtered speed) at 20Hz, which is
             useful while debugging the control loop but log spam otherwise. -->
        <param name="verbose_telemetry">false</param>
      </hardware>
      <joint name="${prefix}left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <sensor name="battery">
        <state_interface name="voltage"/>
      </sensor>
    </ros2_control>

  </xacro:macro>

</robot>
